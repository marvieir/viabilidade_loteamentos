# Reverse proxy de produção — HTTPS automático (Let's Encrypt) + security headers.
# O domínio vem do ambiente (DOMINIO) — ver docker-compose.prod.yml.
{$DOMINIO} {
	encode gzip

	# Cabeçalhos de segurança (defesa em profundidade — o app também envia alguns).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API → serviço interno (sem porta pública). O front fala /api/* com o mesmo domínio.
	handle /api/* {
		reverse_proxy api:8700
	}
	handle /health {
		reverse_proxy api:8700
	}

	# Resto → frontend Next.js.
	handle {
		reverse_proxy web:3700
	}
}

# SEO (31/07): www redireciona para o apex — um domínio canônico só, sem conteúdo duplicado.
# O DNS já tem o CNAME www → voaz.app; o Caddy emite o certificado do www automaticamente.
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# Migração de domínio (30/07): o endereço antigo redireciona PERMANENTE para o novo.
# DOMINIO_ANTIGO é opcional — sem ele no .env, o bloco atende um host vazio e fica inerte.
# O Caddy emite TLS também para o antigo (precisa do DNS dele apontando para esta instância),
# então quem acessar https://viabilidade.homeeye.ai chega com cadeado e sai em voaz.app.
{$DOMINIO_ANTIGO:invalido.localhost} {
	redir https://{$DOMINIO}{uri} permanent
}
